{
  "format": "virtual-effect",
  "version": 2,
  "id": "cyclic-cells",
  "name": "Cyclic Cells",
  "description": "Video-seeded cyclic cellular color takeover. Neighboring cells advance to the next color state; one or two local generations create pixel colonies and color bands.",
  "role": "effect",
  "targets": [
    "master",
    "deck"
  ],
  "abi": "deck-v1",
  "shader": "cyclic_cells.wgsl",
  "parameters": [
    {
      "id": "cells",
      "label": "Cells vertically",
      "minimum": 8,
      "maximum": 180,
      "default": 48,
      "group": "Grid"
    },
    {
      "id": "threshold",
      "label": "Seed threshold",
      "minimum": 0,
      "maximum": 1,
      "default": 0.35,
      "group": "Rules"
    },
    {
      "id": "mutation",
      "label": "Seed mutation",
      "minimum": 0,
      "maximum": 0.4,
      "default": 0.04,
      "group": "Rules"
    },
    {
      "id": "gap",
      "label": "Cell gap",
      "minimum": 0,
      "maximum": 0.15,
      "default": 0.04,
      "group": "Grid"
    },
    {
      "id": "speed",
      "label": "Mutation rate",
      "minimum": 0,
      "maximum": 30,
      "default": 4,
      "group": "Rules"
    },
    {
      "id": "generations",
      "label": "Local generations",
      "minimum": 1,
      "maximum": 2,
      "default": 2,
      "group": "Rules"
    },
    {
      "id": "states",
      "label": "Color states",
      "minimum": 3,
      "maximum": 8,
      "default": 5,
      "group": "Rules"
    },
    {
      "id": "neighbors",
      "label": "Neighbor threshold",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "group": "Rules"
    },
    {
      "id": "palette",
      "label": "Palette shift",
      "minimum": 0,
      "maximum": 1,
      "default": 0.55,
      "group": "Color"
    }
  ],
  "presets": [
    {
      "id": "colonies",
      "label": "Color colonies",
